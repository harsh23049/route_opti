{
  "name": "smart-delivery-optimizer-monorepo",
  "version": "2.0.0",
  "description": "Smart Delivery Route Optimization Monorepo (C++17 Engine + Express API + React Frontend)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:cpp": "cmake -S algorithms -B algorithms/build -DCMAKE_BUILD_TYPE=Release && cmake --build algorithms/build --config Release",
    "test:cpp": "ctest --test-dir algorithms/build -C Release --output-on-failure",
    "build:frontend": "npm run build -w frontend",
    "test:backend": "npm test -w backend",
    "test:frontend": "npm test -w frontend",
    "test:e2e": "node --test scripts/e2e.test.js",
    "test": "npm run test:cpp && npm run test:backend && npm run test:frontend && npm run test:e2e",
    "lint": "eslint .",
    "bench": "node scripts/benchmark.js",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "start": "node backend/src/app.js"
  },
  "keywords": [
    "route-optimization",
    "tsp",
    "dijkstra",
    "two-opt",
    "or-opt",
    "held-karp",
    "nearest-neighbor",
    "cpp17",
    "express",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0"
  }
}
